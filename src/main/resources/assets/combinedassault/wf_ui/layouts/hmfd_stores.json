{
 "scaling": "absolute",
 "size": [
  120,
  148
 ],
 "use": [
  "combinedassault:hud"
 ],
 "constants": {
  "bg": "#ff000000",
  "fg": "#ff52f06a",
  "dim": "#ff1f7a30",
  "warn": "#ffffb02e",
  "alarm": "#ffff4a3a",
  "cyan": "#ff46c8ff",
  "inv": "#ff000000"
 },
 "root": {
  "type": "stack",
  "children": [
   {
    "type": "rect",
    "w": 120,
    "h": 148,
    "color": "$bg"
   },
   {
    "type": "place",
    "x": 3,
    "y": 2,
    "child": {
     "type": "text",
     "text": "WPN",
     "color": "$fg",
     "scale": 0.85
    }
   },
   {
    "type": "place",
    "x": 117,
    "y": 2,
    "child": {
     "type": "text",
     "text": "{mfd.time}",
     "color": "$dim",
     "scale": 0.85
    },
    "pivot": "top_right"
   },
   {
    "type": "place",
    "x": 0,
    "y": 11,
    "child": {
     "type": "rect",
     "w": 120,
     "h": 0.7,
     "color": "$dim"
    }
   },
   {
    "type": "place",
    "x": 3,
    "y": 15,
    "child": {
     "type": "repeat",
     "items": "station.weapons",
     "columns": 1,
     "gap": 1,
     "max": 7,
     "child": {
      "type": "sized",
      "w": 114,
      "h": 11,
      "child": {
       "type": "stack",
       "children": [
        {
         "type": "when",
         "if": "index == station.active_index",
         "then": {
          "type": "rect",
          "w": 114,
          "h": 10.5,
          "color": "$fg"
         }
        },
        {
         "type": "place",
         "x": 2,
         "y": 1.5,
         "child": {
          "type": "text",
          "text": "{weapon.name}",
          "color": "index == station.active_index ? $inv : $fg",
          "scale": 0.85,
          "max_width": 80
         }
        },
        {
         "type": "place",
         "x": 112,
         "y": 1.5,
         "child": {
          "type": "text",
          "text": "{weapon.ammo}",
          "color": "index == station.active_index ? $inv : weapon.ammo == 0 ? $alarm : $fg",
          "scale": 0.85
         },
         "pivot": "top_right"
        }
       ]
      }
     }
    }
   },
   {
    "type": "place",
    "x": 5,
    "y": 97,
    "child": {
     "type": "when",
     "if": "station.flares",
     "then": {
      "type": "text",
      "text": "FLARE {independent.ammo}",
      "color": "independent.ammo == 0 ? $alarm : $cyan",
      "scale": 0.85
     }
    }
   },
   {
    "type": "place",
    "x": 115,
    "y": 97,
    "child": {
     "type": "when",
     "if": "fixed_wing.bays > 0",
     "then": {
      "type": "when",
      "if": "fixed_wing.bay_open",
      "then": {
       "type": "text",
       "text": "BAY OPEN",
       "color": "$warn",
       "scale": 0.85
      },
      "else": {
       "type": "text",
       "text": "BAY SHUT",
       "color": "$fg",
       "scale": 0.85
      }
     }
    },
    "pivot": "top_right"
   }
  ]
 }
}