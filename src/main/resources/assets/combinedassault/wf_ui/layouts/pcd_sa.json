{
 "scaling": "absolute",
 "size": [
  154,
  100
 ],
 "use": [
  "combinedassault:hud"
 ],
 "constants": {
  "bg": "#ff000000",
  "fg": "#ff52f06a",
  "dim": "#ff1f7a30",
  "warn": "#ffffb02e",
  "alarm": "#ffff4a3a",
  "cyan": "#ff46c8ff",
  "inv": "#ff000000"
 },
 "root": {
  "type": "stack",
  "children": [
   {
    "type": "rect",
    "w": 154,
    "h": 100,
    "color": "$bg"
   },
   {
    "type": "place",
    "x": 3,
    "y": 2,
    "child": {
     "type": "text",
     "text": "TSD",
     "color": "$fg",
     "scale": 0.85
    }
   },
   {
    "type": "place",
    "x": 151,
    "y": 2,
    "child": {
     "type": "text",
     "text": "{mfd.time}",
     "color": "$dim",
     "scale": 0.85
    },
    "pivot": "top_right"
   },
   {
    "type": "place",
    "x": 0,
    "y": 11,
    "child": {
     "type": "rect",
     "w": 154,
     "h": 0.7,
     "color": "$dim"
    }
   },
   {
    "type": "place",
    "x": 0,
    "y": 12,
    "child": {
     "type": "combinedassault:mfd_situation",
     "w": 108,
     "h": 88
    }
   },
   {
    "type": "when",
    "if": "mfd.launch",
    "then": {
     "type": "place",
     "x": 54.0,
     "y": 86,
     "child": {
      "type": "text",
      "text": "MISSILE",
      "color": "blink(0.25) ? $alarm : #ff801810",
      "scale": 1.2
     },
     "pivot": "top"
    },
    "else": {
     "type": "when",
     "if": "mfd.lock",
     "then": {
      "type": "place",
      "x": 54.0,
      "y": 86,
      "child": {
       "type": "text",
       "text": "LOCK",
       "color": "$warn",
       "scale": 1.1
      },
      "pivot": "top"
     }
    }
   },
   {
    "type": "place",
    "x": 108,
    "y": 12,
    "child": {
     "type": "rect",
     "w": 0.7,
     "h": 88,
     "color": "$dim"
    }
   },
   {
    "type": "place",
    "x": 111,
    "y": 16,
    "child": {
     "type": "text",
     "text": "FUEL",
     "color": "$dim",
     "scale": 0.7
    }
   },
   {
    "type": "place",
    "x": 151,
    "y": 23,
    "child": {
     "type": "text",
     "text": "{trunc(vehicle.fuel)}%",
     "color": "vehicle.fuel < 15 ? $alarm : $fg",
     "scale": 0.85
    },
    "pivot": "top_right"
   },
   {
    "type": "place",
    "x": 111,
    "y": 36,
    "child": {
     "type": "text",
     "text": "SPD",
     "color": "$dim",
     "scale": 0.7
    }
   },
   {
    "type": "place",
    "x": 151,
    "y": 43,
    "child": {
     "type": "text",
     "text": "{trunc(vehicle.speed)}",
     "color": "$fg",
     "scale": 0.85
    },
    "pivot": "top_right"
   },
   {
    "type": "place",
    "x": 111,
    "y": 56,
    "child": {
     "type": "text",
     "text": "ALT",
     "color": "$dim",
     "scale": 0.7
    }
   },
   {
    "type": "place",
    "x": 151,
    "y": 63,
    "child": {
     "type": "text",
     "text": "{trunc(vehicle.altitude)}",
     "color": "$fg",
     "scale": 0.85
    },
    "pivot": "top_right"
   },
   {
    "type": "place",
    "x": 111,
    "y": 76,
    "child": {
     "type": "text",
     "text": "G",
     "color": "$dim",
     "scale": 0.7
    }
   },
   {
    "type": "place",
    "x": 151,
    "y": 83,
    "child": {
     "type": "text",
     "text": "{local.g|.1}",
     "color": "$fg",
     "scale": 0.85
    },
    "pivot": "top_right"
   }
  ]
 }
}