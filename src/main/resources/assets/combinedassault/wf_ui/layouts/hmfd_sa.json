{
 "scaling": "absolute",
 "size": [
  120,
  148
 ],
 "use": [
  "combinedassault:hud"
 ],
 "constants": {
  "bg": "#ff000000",
  "fg": "#ff52f06a",
  "dim": "#ff1f7a30",
  "warn": "#ffffb02e",
  "alarm": "#ffff4a3a",
  "cyan": "#ff46c8ff",
  "inv": "#ff000000"
 },
 "root": {
  "type": "stack",
  "children": [
   {
    "type": "rect",
    "w": 120,
    "h": 148,
    "color": "$bg"
   },
   {
    "type": "place",
    "x": 3,
    "y": 2,
    "child": {
     "type": "text",
     "text": "TSD",
     "color": "$fg",
     "scale": 0.85
    }
   },
   {
    "type": "place",
    "x": 117,
    "y": 2,
    "child": {
     "type": "text",
     "text": "{mfd.time}",
     "color": "$dim",
     "scale": 0.85
    },
    "pivot": "top_right"
   },
   {
    "type": "place",
    "x": 0,
    "y": 11,
    "child": {
     "type": "rect",
     "w": 120,
     "h": 0.7,
     "color": "$dim"
    }
   },
   {
    "type": "place",
    "x": 0,
    "y": 12,
    "child": {
     "type": "combinedassault:mfd_situation",
     "w": 120,
     "h": 136
    }
   },
   {
    "type": "when",
    "if": "mfd.launch",
    "then": {
     "type": "place",
     "x": 60.0,
     "y": 134,
     "child": {
      "type": "text",
      "text": "MISSILE",
      "color": "blink(0.25) ? $alarm : #ff801810",
      "scale": 1.2
     },
     "pivot": "top"
    },
    "else": {
     "type": "when",
     "if": "mfd.lock",
     "then": {
      "type": "place",
      "x": 60.0,
      "y": 134,
      "child": {
       "type": "text",
       "text": "LOCK",
       "color": "$warn",
       "scale": 1.1
      },
      "pivot": "top"
     }
    }
   }
  ]
 }
}