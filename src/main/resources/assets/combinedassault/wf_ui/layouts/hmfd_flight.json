{
 "scaling": "absolute",
 "size": [
  120,
  148
 ],
 "use": [
  "combinedassault:hud"
 ],
 "constants": {
  "bg": "#ff000000",
  "fg": "#ff52f06a",
  "dim": "#ff1f7a30",
  "warn": "#ffffb02e",
  "alarm": "#ffff4a3a",
  "cyan": "#ff46c8ff",
  "inv": "#ff000000"
 },
 "root": {
  "type": "stack",
  "children": [
   {
    "type": "rect",
    "w": 120,
    "h": 148,
    "color": "$bg"
   },
   {
    "type": "place",
    "x": 3,
    "y": 2,
    "child": {
     "type": "text",
     "text": "FLT",
     "color": "$fg",
     "scale": 0.85
    }
   },
   {
    "type": "place",
    "x": 117,
    "y": 2,
    "child": {
     "type": "text",
     "text": "{mfd.time}",
     "color": "$dim",
     "scale": 0.85
    },
    "pivot": "top_right"
   },
   {
    "type": "place",
    "x": 0,
    "y": 11,
    "child": {
     "type": "rect",
     "w": 120,
     "h": 0.7,
     "color": "$dim"
    }
   },
   {
    "type": "place",
    "x": 30.0,
    "y": 15,
    "child": {
     "type": "combinedassault:mfd_adi",
     "w": 60,
     "h": 70
    }
   },
   {
    "type": "place",
    "x": 3,
    "y": 17,
    "child": {
     "type": "text",
     "text": "SPD",
     "color": "$dim",
     "scale": 0.7
    }
   },
   {
    "type": "place",
    "x": 3,
    "y": 23,
    "child": {
     "type": "text",
     "text": "{trunc(vehicle.speed)}",
     "color": "$fg",
     "scale": 0.8
    }
   },
   {
    "type": "place",
    "x": 3,
    "y": 32,
    "child": {
     "type": "text",
     "text": "ALT",
     "color": "$dim",
     "scale": 0.7
    }
   },
   {
    "type": "place",
    "x": 3,
    "y": 38,
    "child": {
     "type": "text",
     "text": "{trunc(vehicle.altitude)}",
     "color": "$fg",
     "scale": 0.8
    }
   },
   {
    "type": "place",
    "x": 3,
    "y": 47,
    "child": {
     "type": "text",
     "text": "VS",
     "color": "$dim",
     "scale": 0.7
    }
   },
   {
    "type": "place",
    "x": 3,
    "y": 53,
    "child": {
     "type": "text",
     "text": "{trunc(vehicle.vspeed)}",
     "color": "$fg",
     "scale": 0.8
    }
   },
   {
    "type": "when",
    "if": "vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 17,
     "child": {
      "type": "text",
      "text": "RPM",
      "color": "$dim",
      "scale": 0.7
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 23,
     "child": {
      "type": "text",
      "text": "{trunc(rotary.rpm)}",
      "color": "$fg",
      "scale": 0.8
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "!vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 17,
     "child": {
      "type": "text",
      "text": "THR",
      "color": "$dim",
      "scale": 0.7
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "!vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 23,
     "child": {
      "type": "text",
      "text": "{trunc(fixed_wing.throttle)}",
      "color": "$fg",
      "scale": 0.8
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 32,
     "child": {
      "type": "text",
      "text": "COL",
      "color": "$dim",
      "scale": 0.7
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 38,
     "child": {
      "type": "text",
      "text": "{trunc(rotary.collective)}",
      "color": "$fg",
      "scale": 0.8
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "!vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 32,
     "child": {
      "type": "text",
      "text": "G",
      "color": "$dim",
      "scale": 0.7
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "!vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 38,
     "child": {
      "type": "text",
      "text": "{local.g|.1}",
      "color": "$fg",
      "scale": 0.8
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 47,
     "child": {
      "type": "text",
      "text": "HDG",
      "color": "$dim",
      "scale": 0.7
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 53,
     "child": {
      "type": "text",
      "text": "{trunc(mfd.heading)|03}",
      "color": "$fg",
      "scale": 0.8
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "!vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 47,
     "child": {
      "type": "text",
      "text": "HDG",
      "color": "$dim",
      "scale": 0.7
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "when",
    "if": "!vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 53,
     "child": {
      "type": "text",
      "text": "{trunc(mfd.heading)|03}",
      "color": "$fg",
      "scale": 0.8
     },
     "pivot": "top_right"
    }
   },
   {
    "type": "place",
    "x": 3,
    "y": 89,
    "child": {
     "type": "text",
     "text": "FUEL",
     "color": "$dim",
     "scale": 0.75
    }
   },
   {
    "type": "place",
    "x": 26,
    "y": 90,
    "child": {
     "type": "bar",
     "w": 58,
     "h": 5,
     "value": "vehicle.fuel / 100",
     "fill": "vehicle.fuel < 15 ? $alarm : $fg",
     "back": "#ff0c2a12"
    }
   },
   {
    "type": "place",
    "x": 117,
    "y": 89,
    "child": {
     "type": "text",
     "text": "{vehicle.fuel_seconds|clockh}",
     "color": "vehicle.fuel < 15 ? $alarm : $fg",
     "scale": 0.75
    },
    "pivot": "top_right"
   },
   {
    "type": "when",
    "if": "vehicle.rotary",
    "then": {
     "type": "place",
     "x": 3,
     "y": 99,
     "child": {
      "type": "text",
      "text": "RPM",
      "color": "$dim",
      "scale": 0.75
     }
    }
   },
   {
    "type": "when",
    "if": "vehicle.rotary",
    "then": {
     "type": "place",
     "x": 26,
     "y": 100,
     "child": {
      "type": "bar",
      "w": 91,
      "h": 5,
      "value": "min(rotary.rpm, 100) / 100",
      "fill": "rotary.rpm > 100 ? $warn : $fg",
      "back": "#ff0c2a12"
     }
    }
   },
   {
    "type": "when",
    "if": "!vehicle.rotary",
    "then": {
     "type": "place",
     "x": 3,
     "y": 99,
     "child": {
      "type": "text",
      "text": "THR",
      "color": "$dim",
      "scale": 0.75
     }
    }
   },
   {
    "type": "when",
    "if": "!vehicle.rotary",
    "then": {
     "type": "place",
     "x": 26,
     "y": 100,
     "child": {
      "type": "bar",
      "w": 91,
      "h": 5,
      "value": "min(fixed_wing.throttle, 100) / 100",
      "fill": "fixed_wing.throttle > 100 ? $warn : $fg",
      "back": "#ff0c2a12"
     }
    }
   },
   {
    "type": "when",
    "if": "!vehicle.rotary",
    "then": {
     "type": "place",
     "x": 3,
     "y": 110,
     "child": {
      "type": "when",
      "if": "fixed_wing.gear_up",
      "then": {
       "type": "text",
       "text": "GEAR UP",
       "color": "$fg",
       "scale": 0.8
      },
      "else": {
       "type": "text",
       "text": "GEAR DN",
       "color": "$warn",
       "scale": 0.8
      }
     }
    }
   },
   {
    "type": "when",
    "if": "!vehicle.rotary",
    "then": {
     "type": "place",
     "x": 117,
     "y": 110,
     "child": {
      "type": "when",
      "if": "fixed_wing.nozzle == fixed_wing.nozzle",
      "then": {
       "type": "text",
       "text": "NAC {trunc(fixed_wing.nozzle)}",
       "color": "$cyan",
       "scale": 0.8
      }
     },
     "pivot": "top_right"
    }
   }
  ]
 }
}