{
 "use": [
  "combinedassault:hud"
 ],
 "root": {
  "type": "stack",
  "children": [
   {
    "type": "anchor",
    "at": "bottom",
    "margin": 4,
    "dx": "-(ui.width % 2) / 2",
    "dy": "-(1.1 * (min(3, vehicle.system_count) * 13 - 2) + 2)",
    "child": {
     "type": "transform",
     "scale": 1.1,
     "pivot": "bottom",
     "child": {
      "type": "column",
      "align": "center",
      "children": [
       {
        "type": "combinedassault:hud/readouts"
       },
       {
        "type": "sized",
        "w": 150,
        "h": 2
       },
       {
        "type": "when",
        "if": "vehicle.payload_shown",
        "then": {
         "type": "text",
         "text": "{tr:ui.vehicle_load(vehicle.payload_t|.1, vehicle.payload_max_t|.1, vehicle.payload_pct|.0)}",
         "color": "vehicle.payload_pct > 100 ? $red : vehicle.payload_pct >= 70 ? $amber : $green",
         "shadow": true,
         "scale": 0.75
        }
       },
       {
        "type": "text",
        "text": "{vehicle.name}",
        "color": "vehicle.name_color",
        "shadow": true
       },
       {
        "type": "sized",
        "w": 150,
        "h": 2
       },
       {
        "type": "bar",
        "w": 150,
        "h": 3,
        "value": "vehicle.hull",
        "back": "#a0101014",
        "fill": "vehicle.hull_state == 0 ? #ffe6e6e6 : vehicle.hull_state == 1 ? #ffe8d060 : vehicle.hull_state == 2 ? #ffe08830 : #ffb82820"
       },
       {
        "type": "sized",
        "w": 150,
        "h": 3
       }
      ]
     }
    }
   },
   {
    "type": "anchor",
    "at": "bottom",
    "margin": 2,
    "dx": "-(ui.width % 2) / 2",
    "child": {
     "type": "transform",
     "scale": 1.1,
     "pivot": "bottom",
     "child": {
      "type": "row",
      "gap": 6,
      "children": [
       {
        "type": "sized",
        "w": 129,
        "h": 1
       },
       {
        "type": "box",
        "min_width": 150,
        "align": "top",
        "child": {
         "type": "repeat",
         "items": "vehicle.systems",
         "rows": 3,
         "gap": 2,
         "child": {
          "type": "box",
          "min_width": 30,
          "min_height": 11,
          "align": "center",
          "border_width": 0,
          "background": "system.state == 0 ? #ffe6e6e6 : system.state == 1 ? #ffe8d060 : system.state == 2 ? #ffe08830 : #ffb82820",
          "child": {
           "type": "text",
           "text": "{system.label}",
           "color": "system.state == 3 ? #ffffffff : #ff202020",
           "scale": 0.6
          }
         }
        }
       },
       {
        "type": "sized",
        "w": 50,
        "h": 73,
        "align": "bottom_right",
        "child": {
         "type": "when",
         "if": "!vehicle.none",
         "then": {
          "type": "column",
          "gap": 1,
          "align": "end",
          "children": [
           {
            "type": "text",
            "text": "{vehicle.speed} km/h",
            "color": "local.driver && fixed_wing.present && fixed_wing.can_lift_off ? $green : #ffffffff",
            "shadow": true
           },
           {
            "type": "text",
            "text": "{vehicle.fuel_label} {vehicle.fuel|.1}%",
            "color": "vehicle.fuel < 5 ? $red : $white",
            "shadow": true,
            "scale": 0.5
           }
          ]
         }
        }
       },
       {
        "type": "sized",
        "w": 73,
        "h": 73,
        "child": {
         "type": "place",
         "x": 36.5,
         "y": 36.5,
         "child": {
          "type": "combinedassault:vehicle_schematic",
          "fit": "73",
          "hull_up": true,
          "systems": true
         }
        }
       }
      ],
      "align": "end"
     }
    }
   }
  ]
 }
}