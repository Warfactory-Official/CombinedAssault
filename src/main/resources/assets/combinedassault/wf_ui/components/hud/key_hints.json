{
  "use": [
    "combinedassault:hud"
  ],
  "root": {
    "type": "when",
    "if": "ui.width >= 440",
    "then": {
      "type": "place",
      "x": 4,
      "y": "ui.height - 6",
      "pivot": "bottom_left",
      "child": {
        "type": "column",
        "gap": 1.5,
        "children": [
          {
            "type": "key_hint",
            "if": "!local.scope",
            "label": "{tr:hud.combinedassault.hint.exit}",
            "key": "key.combinedassault.leave_vehicle.desc"
          },
          {
            "type": "key_hint",
            "if": "!local.scope",
            "label": "{tr:hud.combinedassault.hint.seat}",
            "key": "key.combinedassault.change_seat.desc"
          },
          {
            "type": "key_hint",
            "if": "local.turn_out",
            "label": "{tr:hud.combinedassault.hint.turn_out}",
            "key": "key.combinedassault.turn_out.desc"
          },
          {
            "type": "key_hint",
            "if": "local.sight_screen_seat",
            "label": "{tr:hud.combinedassault.hint.gun_sight}",
            "key": "key.combinedassault.magnification_change.desc"
          },
          {
            "type": "key_hint",
            "if": "local.periscope_seat",
            "label": "{tr:hud.combinedassault.hint.periscope}",
            "key": "key.combinedassault.magnification_change.desc"
          },
          {
            "type": "key_hint",
            "if": "!local.scope",
            "label": "{tr:hud.combinedassault.hint.view}",
            "key": "key.combinedassault.switch_view.desc"
          },
          {
            "type": "key_hint",
            "if": "!local.scope",
            "label": "{tr:hud.combinedassault.hint.free_look}",
            "key": "key.combinedassault.free_camera.desc"
          },
          {
            "type": "key_hint",
            "if": "!local.scope",
            "label": "{tr:hud.combinedassault.hint.inspect}",
            "key": "key.combinedassault.inspect_vehicle.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && !vehicle.none",
            "label": "{tr:hud.combinedassault.hint.engine}",
            "key": "key.combinedassault.toggle_engine.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && vehicle.ground",
            "label": "{tr:hud.combinedassault.hint.drive}",
            "key": "key.combinedassault.forward.desc",
            "key2": "key.combinedassault.backward.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && vehicle.ground",
            "label": "{tr:hud.combinedassault.hint.steer}",
            "key": "key.combinedassault.left.desc",
            "key2": "key.combinedassault.right.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && vehicle.wheeled",
            "label": "{tr:hud.combinedassault.hint.handbrake}",
            "key": "key.combinedassault.up.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && vehicle.manual",
            "label": "{tr:hud.combinedassault.hint.shift}",
            "key": "key.combinedassault.shift_up.desc",
            "key2": "key.combinedassault.shift_down.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && vehicle.lights",
            "label": "{tr:hud.combinedassault.hint.lights}",
            "key": "key.combinedassault.toggle_lights.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && vehicle.hitches",
            "label": "{tr:hud.combinedassault.hint.tow}",
            "key": "key.combinedassault.tow_couple.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && vehicle.rotary",
            "label": "{tr:hud.combinedassault.hint.hover}",
            "key": "key.combinedassault.toggle_hover_mode.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && fixed_wing.present",
            "label": "{tr:hud.combinedassault.hint.aerobatic_smoke}",
            "key": "key.combinedassault.toggle_aerobatic_smoke.desc"
          },
          {
            "type": "key_hint",
            "if": "!local.scope && !vehicle.none",
            "label": "{tr:hud.combinedassault.hint.storage}",
            "key": "key.combinedassault.open_inventory.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && fixed_wing.present",
            "label": "{tr:hud.combinedassault.hint.gear}",
            "key": "key.combinedassault.toggle_landing_gear.desc"
          },
          {
            "type": "key_hint",
            "if": "!local.scope && vehicle.cargo_door",
            "label": "{tr:hud.combinedassault.hint.cargo_door}",
            "key": "key.combinedassault.toggle_cargo_door.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && fixed_wing.present",
            "label": "{tr:hud.combinedassault.hint.airbrake}",
            "key": "key.combinedassault.toggle_airbrake.desc"
          },
          {
            "type": "key_hint",
            "if": "local.driver && fixed_wing.present",
            "label": "{tr:hud.combinedassault.hint.flaps}",
            "key": "key.combinedassault.flaps_down.desc",
            "key2": "key.combinedassault.flaps_up.desc"
          }
        ]
      }
    }
  }
}
