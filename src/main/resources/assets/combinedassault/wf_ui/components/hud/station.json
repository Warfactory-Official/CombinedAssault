{
  "use": ["combinedassault:hud"],
  "root": {"type": "stack", "children": [
    {"type": "when", "if": "!local.scope", "then": {"type": "stack", "children": [
      {"type": "combinedassault:aim_reticle", "color": "$white"},
      {"type": "combinedassault:impact_markers", "color": "$white"},
      {"type": "combinedassault:lock_markers"}
    ]}},
    {"type": "combinedassault:hud/weapon_card"},
    {"type": "when", "if": "!local.radar_full", "then": {"type": "place", "x": "ui.width / 2 + 128", "y": "ui.height - 80", "child": {"type": "combinedassault:radar_scopes"}}},
    {"type": "when", "if": "vehicle.rwr && !local.radar_full",
      "then": {"type": "place", "x": "ui.width - 40", "y": "ui.height - 180", "child": {"type": "combinedassault:rwr"}}}
  ]}
}
