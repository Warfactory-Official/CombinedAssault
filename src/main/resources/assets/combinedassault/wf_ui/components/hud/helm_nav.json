{
 "use": [
  "combinedassault:hud"
 ],
 "constants": {
  "rudder": "smooth(ship.rudder, 0.1)"
 },
 "root": {
  "type": "stack",
  "children": [
   {
    "type": "rect",
    "w": 126,
    "h": 60,
    "color": "$shade"
   },
   {
    "type": "place",
    "x": 5,
    "y": 5,
    "child": {
     "type": "stack",
     "children": [
      {
       "type": "combinedassault:hud/console_row",
       "y": 0,
       "key": "ui.combinedassault.helm.rudder",
       "value": {
        "type": "when",
        "if": "round($rudder * 100) > 0",
        "then": {
         "type": "text",
         "text": "{tr:ui.combinedassault.helm.starboard(round($rudder * 100))}",
         "color": "$white",
         "shadow": true
        },
        "else": {
         "type": "when",
         "if": "round($rudder * 100) < 0",
         "then": {
          "type": "text",
          "text": "{tr:ui.combinedassault.helm.port(-round($rudder * 100))}",
          "color": "$white",
          "shadow": true
         },
         "else": {
          "type": "text",
          "text": "{tr:ui.combinedassault.helm.midships}",
          "color": "$white",
          "shadow": true
         }
        }
       }
      },
      {
       "type": "combinedassault:hud/bipolar",
       "y": 12,
       "value": "$rudder",
       "color": "$white"
      },
      {
       "type": "combinedassault:hud/console_row",
       "y": 25,
       "key": "ui.combinedassault.helm.course",
       "value": {
        "type": "text",
        "text": "{mod(round(ship.course), 360)|03}",
        "color": "$white",
        "shadow": true
       }
      },
      {
       "type": "place",
       "y": 37,
       "child": {
        "type": "stack",
        "children": [
         {
          "type": "rect",
          "w": 116,
          "h": 14,
          "color": "$track"
         },
         {
          "type": "place",
          "y": 1,
          "child": {
           "type": "tape",
           "value": "ship.course",
           "ppu": 2,
           "step": 5,
           "major_every": 2,
           "extent": 58,
           "minor_length": 3,
           "major_length": 5,
           "labels": true,
           "label_offset": 5,
           "wrap": [
            0,
            360
           ],
           "names": {
            "0": "N",
            "90": "E",
            "180": "S",
            "270": "W"
           },
           "color": "$scale",
           "label_color": "$label",
           "label_scale": 0.1,
           "label_pad": 2,
           "name_color": "$label",
           "major_color": "$label"
          }
         },
         {
          "type": "place",
          "x": 58,
          "y": -4,
          "child": {
           "type": "rect",
           "w": 1,
           "h": 9,
           "color": "$white"
          }
         },
         {
          "type": "place",
          "x": 56,
          "y": -4,
          "child": {
           "type": "rect",
           "w": 5,
           "h": 1,
           "color": "$white"
          }
         }
        ]
       }
      }
     ]
    }
   }
  ]
 }
}