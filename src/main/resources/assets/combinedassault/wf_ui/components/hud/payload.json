{
  "use": ["combinedassault:hud"],
  "root": {"type": "place", "x": "floor(ui.width / 2) - 120", "y": "floor(ui.height / 2) + 27",
    "child": {"type": "column", "gap": 4, "children": [
      {"type": "when", "if": "payload.single",
        "then": {"type": "text", "text": "{payload.name}", "color": "$green", "shadow": true},
        "else": {"type": "text", "text": "{tr:ui.vehicle_payload.rounds(payload.remaining, payload.capacity)}",
          "color": "$green", "shadow": true}},
      {"type": "when", "if": "payload.armable", "then": {"type": "when", "if": "!payload.armed",
        "then": {"type": "text", "text": "{tr:ui.vehicle_payload.safe(payload.arm_key)}", "color": "$gray", "shadow": true},
        "else": {"type": "when", "if": "!payload.live",
          "then": {"type": "text", "text": "{tr:ui.vehicle_payload.arming(payload.arming|.1)}", "color": "$amber",
            "shadow": true},
          "else": {"type": "when", "if": "payload.releasable",
            "then": {"type": "text", "text": "{tr:ui.vehicle_payload.armed_release(payload.fire_key, payload.release_key)}",
              "color": "$red", "shadow": true},
            "else": {"type": "text", "text": "{tr:ui.vehicle_payload.armed(payload.fire_key)}", "color": "$red",
              "shadow": true}}}}}
    ]}}
}
