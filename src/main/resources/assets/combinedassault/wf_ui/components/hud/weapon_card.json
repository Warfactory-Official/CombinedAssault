{
  "constants": {
    "ammo": "primary.ammo == 0 ? #ffff6040 : primary.ammo <= floor(primary.capacity / 4) ? #ddffaa00 : $text",
    "ammo_bar": "primary.ammo == 0 ? #ffff6040 : primary.ammo <= floor(primary.capacity / 4) ? #ddffaa00 : $text",
    "heat": "primary.temp >= 450 ? #ffff5020 : primary.temp >= 150 ? #ffffa030 : $dim",
    "status": "primary.reloading || primary.jammed || primary.changing > 0",
    "side": "secondary.present || independent.present"
  },
  "use": [
    "combinedassault:hud"
  ],
  "root": {
    "type": "when",
    "if": "station.weapon_count > 0",
    "then": {
      "type": "place",
      "x": "ui.width - 4",
      "y": "ui.height - 7",
      "pivot": "bottom_right",
      "child": {
        "type": "transform",
        "scale": 0.75,
        "pivot": "bottom_right",
        "child": {
          "type": "column",
          "gap": 3,
          "align": "end",
          "children": [
            {
              "type": "combinedassault:weapon_list"
            },
            {
              "type": "sized",
              "w": 130,
              "h": 44,
              "child": {
                "type": "stack",
                "children": [
                  {
                    "type": "box",
                    "background": "$panel",
                    "border": "$edge",
                    "min_width": 130,
                    "min_height": 44
                  },
                  {
                    "type": "place",
                    "x": 5,
                    "y": 18,
                    "child": {
                      "type": "row",
                      "gap": 2,
                      "children": [
                        {
                          "type": "when",
                          "if": "primary.jammed",
                          "then": {
                            "type": "when",
                            "if": "primary.clearing > 0",
                            "then": {
                              "type": "text",
                              "text": "CLEAR {primary.clearing * 100}%",
                              "color": "#ffffaa00"
                            },
                            "else": {
                              "type": "text",
                              "text": "JAMMED",
                              "color": "blink(0.5) ? #ffff6040 : #ff802010"
                            }
                          },
                          "else": {
                            "type": "when",
                            "if": "primary.changing > 0",
                            "then": {
                              "type": "text",
                              "text": "BARREL {primary.changing * 100}%",
                              "color": "#ffffaa00"
                            },
                            "else": {
                              "type": "when",
                              "if": "primary.reloading",
                              "then": {
                                "type": "text",
                                "text": "RELOADING",
                                "color": "#ffff6040"
                              },
                              "else": {
                                "type": "when",
                                "if": "primary.tool",
                                "then": {
                                  "type": "when",
                                  "if": "primary.working",
                                  "then": {
                                    "type": "text",
                                    "text": "ACTIVE",
                                    "color": "#ff60ff60"
                                  },
                                  "else": {
                                    "type": "text",
                                    "text": "STOWED",
                                    "color": "$dim"
                                  }
                                },
                                "else": {
                                  "type": "text",
                                  "text": "{primary.ammo} / {primary.capacity}",
                                  "color": "$ammo"
                                }
                              }
                            }
                          }
                        },
                        {
                          "type": "repeat",
                          "items": "primary.round_variants",
                          "gap": 1,
                          "max": 3,
                          "child": {
                            "type": "ammo_glyph",
                            "size": 8
                          }
                        },
                        {
                          "type": "when",
                          "if": "!primary.tool",
                          "then": {
                            "type": "text",
                            "text": "{primary.round}",
                            "color": "$dim",
                            "max_width": "max(8, (($side) ? ($status || primary.capacity >= 100 ? 28 : primary.capacity >= 10 ? 40 : 50) : 70) - 10 * min(primary.round_variant_count, 3))"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "when",
                    "if": "!primary.tool",
                    "then": {
                      "type": "place",
                      "x": 5,
                      "y": 31,
                      "child": {
                        "type": "when",
                        "if": "$side",
                        "then": {
                          "type": "bar",
                          "w": 68.8,
                          "h": 3,
                          "value": "primary.capacity > 0 ? primary.ammo / primary.capacity : 0",
                          "fill": "$ammo_bar",
                          "back": "$well"
                        },
                        "else": {
                          "type": "bar",
                          "w": 120,
                          "h": 3,
                          "value": "primary.capacity > 0 ? primary.ammo / primary.capacity : 0",
                          "fill": "$ammo_bar",
                          "back": "$well"
                        }
                      }
                    }
                  },
                  {
                    "type": "when",
                    "if": "primary.barrel",
                    "then": {
                      "type": "place",
                      "x": 5,
                      "y": 35,
                      "child": {
                        "type": "column",
                        "gap": 0,
                        "children": [
                          {
                            "type": "when",
                            "if": "$side",
                            "then": {
                              "type": "bar",
                              "w": 68.8,
                              "h": 2,
                              "value": "clamp(primary.heat, 0, 1)",
                              "fill": "$heat",
                              "back": "$well"
                            },
                            "else": {
                              "type": "bar",
                              "w": 120,
                              "h": 2,
                              "value": "clamp(primary.heat, 0, 1)",
                              "fill": "$heat",
                              "back": "$well"
                            }
                          },
                          {
                            "type": "when",
                            "if": "$side",
                            "then": {
                              "type": "bar",
                              "w": 68.8,
                              "h": 1,
                              "value": "primary.wear",
                              "fill": "$dim",
                              "back": "#00000000"
                            },
                            "else": {
                              "type": "bar",
                              "w": 120,
                              "h": 1,
                              "value": "primary.wear",
                              "fill": "$dim",
                              "back": "#00000000"
                            }
                          }
                        ]
                      }
                    }
                  },
                  {
                    "type": "when",
                    "if": "secondary.present",
                    "then": {
                      "type": "combinedassault:hud/weapon_side",
                      "weapon": "secondary",
                      "y": 5
                    }
                  },
                  {
                    "type": "when",
                    "if": "independent.present",
                    "then": {
                      "type": "combinedassault:hud/weapon_side",
                      "weapon": "independent",
                      "y": 25
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  }
}
